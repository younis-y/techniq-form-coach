# Copy to .env and fill in. These are read by server/index.js only — they are
# never sent to the browser, and Vite must not be allowed to inline them, which
# is why none of these names start with VITE_.

# ElevenLabs: text-to-speech and, optionally, the conversational agent.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Google Gemini: the post-set coaching summary.
GEMINI_API_KEY=

# Port the credential proxy listens on. Vite proxies /api here in development.
PORT=8787
